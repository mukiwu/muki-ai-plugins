#!/usr/bin/env bash
# SessionStart hook for the lore plugin.
#
# In projects that already have a docs/lore/ base, injects a standing
# instruction covering the four moments the agent should reach for lore:
#   1. before work  -> lore-consult (read the relevant rules/pitfalls)
#   2. during work  -> lore-capture (record business logic / 眉角 the user
#      shares, or non-obvious root causes confirmed while debugging)
#   3. before commit/PR -> lore-guard (check the diff against recorded lore)
#   4. when words wobble -> lore-ul (align vague/colliding terms into the glossary)
# It also carries a lightweight heartbeat: when the lore base has content
# but lore-check hasn't run in >30 days (tracked via the gitignored
# docs/lore/.lore-last-check stamp), it suggests a health check.
#
# Projects without docs/lore/ stay completely quiet.

set -euo pipefail

PROJECT_DIR="${CLAUDE_PROJECT_DIR:-$PWD}"

# Only inject when this project actually has a lore base.
if [ -d "${PROJECT_DIR}/docs/lore" ]; then
  LORE_DIR="${PROJECT_DIR}/docs/lore"
elif [ -d "docs/lore" ]; then
  LORE_DIR="docs/lore"
else
  exit 0
fi

# The standing instruction. Keep it product-focused: business logic + 眉角,
# never code structure (that fails lore's "could you recover it from code?" test).
#
# Written superpowers-style on purpose: a strong discrete directive (the 1%
# rule) plus a rationalization (red-flag) table beats a polite suggestion.
# This injection fires once per session (startup/clear/compact) and has to
# carry the whole conversation, so the wording is a hammer, not a hint.
message='<EXTREMELY_IMPORTANT>
這個專案有 docs/lore/ 知識庫，記錄程式碼看不出來的隱性知識：商業規則、領域眉角、API 契約／陷阱、決策的 why。

規則（不可協商）：對話中只要有 1% 的可能剛剛出現了「讀現行 code 推不回來的知識」，你就必須停下來評估對應的 lore skill，不等使用者開口。使用者不會叫你記，知識說出口的當下就是唯一的記錄時機。

四個時機與觸發訊號：

1. 動手前 → `lore:lore-consult`。規劃功能、修 bug、要動不熟的程式碼之前先跑，撈相關 rules 與 pitfalls；已知會動哪些檔案時，順手用 `code:` 反查。
2. 對話中（最常漏的一個）→ `lore:lore-capture`。使用者說出這類句子就是訊號：「其實我們的規則是⋯」「這邊要小心⋯」「當初這樣做是因為⋯」「這不是 bug，是故意的」；或你在除錯中確認了非顯而易見的根因。判準：「讀現行 code 推得回來的就不是 lore」。
3. commit / PR 前 → `lore:lore-guard`。用 diff 對照 lore 的 `code:` 連結，確認沒踩到已記錄的規則或 pitfall。
4. 詞彙不對齊 → `lore:lore-ul`。訊號：同詞異義、使用者悄悄改掉你回覆裡的用詞、使用者反覆用 glossary 沒有的詞、code 命名跟使用者講法對不上。已有 glossary 時，對話與新程式碼的命名跟著它走（`not:` 列的是禁用詞）。專案根目錄若有 CONTEXT.md（或 CONTEXT-MAP.md），它就是正典詞彙表（`_Avoid_` 即禁用詞），lore 讀寫都以它為準、不另建 glossary.md。

紅旗表——出現這些念頭代表你正在合理化，停：

| 念頭 | 真相 |
|------|------|
| 這只是閒聊 | 閒聊裡的業務規則最容易流失，先評估 |
| 等做完再記 | 做完就忘了，說出口的當下記錄成本最低 |
| 這太小不值得記 | 判準是 code 推不推得回來，不是大小 |
| 使用者沒叫我記 | 主動提案就是這套系統的設計，問一句要不要記 |
| 我知道他在說什麼 | 懂意思不等於詞彙已對齊，glossary 要白紙黑字 |

不要記的東西不變：程式結構、function 做什麼、任何讀 code 就有的內容。寫入永遠先問過使用者（aligned, never generated）。
</EXTREMELY_IMPORTANT>'

# Heartbeat: only when the base actually has area content (at least one file
# below an area folder), so a freshly scaffolded empty base stays quiet.
stamp="${LORE_DIR}/.lore-last-check"
has_area_content=$(find "$LORE_DIR" -mindepth 2 -name '*.md' -print 2>/dev/null | head -n 1)
if [ -n "$has_area_content" ]; then
  if [ ! -f "$stamp" ]; then
    message="${message}

（這包 lore 尚未跑過健康檢查——找個空檔建議使用者跑一次 \`lore:lore-check\`，看它有沒有真的在幫忙。）"
  elif [ -n "$(find "$stamp" -mtime +30 -print 2>/dev/null)" ]; then
    message="${message}

（距離上次 \`lore:lore-check\` 已超過 30 天——找個空檔建議使用者再體檢一次。）"
  fi
fi

# Glossary gap: glossary.md is created lazily by design (lore-ul, term by
# term, never templated) — but "lazy to create" must not mean "lazy to
# remind". Nudge every session while the gap exists; it self-resolves the
# moment glossary.md (or a post-split <area>/terms.md) shows up on disk.
has_glossary=$(find "$LORE_DIR" -maxdepth 1 -name 'glossary.md' -print 2>/dev/null)
if [ -z "$has_glossary" ]; then
  has_glossary=$(find "$LORE_DIR" -mindepth 2 -name 'terms.md' -print 2>/dev/null | head -n 1)
fi
if [ -z "$has_glossary" ]; then
  # An external glossary counts too: per lore-spec's resolution order, a root
  # CONTEXT.md / CONTEXT-MAP.md is the canonical vocabulary when present.
  for ext in "${PROJECT_DIR}/CONTEXT.md" "${PROJECT_DIR}/CONTEXT-MAP.md" CONTEXT.md CONTEXT-MAP.md; do
    if [ -f "$ext" ]; then
      has_glossary="$ext"
      break
    fi
  done
fi
if [ -n "$has_area_content" ] && [ -z "$has_glossary" ]; then
  message="${message}

（這包 lore 還沒有 glossary——詞彙沒對齊，之後 lore-guard 也沒東西可以核對用字。找個空檔用 \`lore:lore-ul\` 開始跟使用者對幾個關鍵詞。）"
fi

# JSON-escape (single C-level pass per substitution; avoids a char loop).
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

escaped=$(escape_for_json "$message")

# Output as JSON context injection. Field name differs per platform:
#  - Cursor expects additional_context (snake_case)
#  - Claude Code expects hookSpecificOutput.additionalContext (nested)
#  - Copilot CLI / SDK standard expects additionalContext (top-level)
# printf (not heredoc) — works around the bash 5.3+ heredoc hang.
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  printf '{\n  "additional_context": "%s"\n}\n' "$escaped"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$escaped"
else
  printf '{\n  "additionalContext": "%s"\n}\n' "$escaped"
fi

exit 0
